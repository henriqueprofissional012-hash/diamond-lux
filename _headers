# Cabeçalhos de segurança (Cloudflare Pages / Netlify leem este arquivo).
# Site estático, sem backend: o objetivo é fechar o que o navegador permite.
#
# ATENÇÃO: o sha256 abaixo libera o único script inline do index.html
# (`document.documentElement.classList.add('js')`). Se essa linha mudar, o hash
# precisa ser gerado de novo, senão as animações de entrada param de aparecer:
#
#   node -e "const f=require('fs'),c=require('crypto');const h=f.readFileSync('index.html','utf8');[...h.matchAll(/<script(?![^>]*src)[^>]*>([\s\S]*?)<\/script>/g)].forEach(m=>console.log('sha256-'+c.createHash('sha256').update(m[1]).digest('base64')))"

